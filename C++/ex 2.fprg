    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero1, numero2, soma" type="Integer" array="False" size=""/>
            <output expression="&quot;Ol&#225;, escreva um n&#250;mero&quot;" newline="True"/>
            <input variable="numero1"/>
            <output expression="&quot;escreva um segundo n&#250;mero&quot;" newline="True"/>
            <input variable="numero2"/>
            <assign variable="soma" expression="numero1 + numero2"/>
            <output expression="&quot;O resultado da soma &#233; &quot;" newline="False"/>
            <output expression="soma" newline="True"/>
        </body>
